# ──────────── Server ────────────
NODE_ENV=production
PORT=8080
FRONTEND_URL=https://bolt-bot.lovable.app

# ──────────── Database (Railway PostgreSQL) ────────────
DATABASE_URL=postgresql://user:pass@host:5432/cryptobot

# ──────────── Cache (Railway Redis) ────────────
REDIS_URL=redis://default:pass@host:6379

# ──────────── Auth ────────────
JWT_SECRET=troque-isto-por-uma-string-aleatoria-de-64-chars
JWT_EXPIRES_IN=8h
REFRESH_SECRET=outra-string-aleatoria-bem-longa
BCRYPT_ROUNDS=12

# ──────────── Binance ────────────
# NUNCA habilitar permissão de saque na chave de API
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# ──────────── Integrações ────────────
WHALE_ALERT_KEY=
CRYPTO_PANIC_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
REPORT_EMAIL=

# ──────────── Bot ────────────
DEFAULT_ENTRY_USDT=500
ATR_STOP_MULTIPLIER=1.5
MAX_DAILY_LOSS_PCT=2
MAX_OPEN_TRADES=5
REAL_MODE_ENABLED=false
